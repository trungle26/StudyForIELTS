PORT=8000
NODE_ENV=development
CORS_ALLOW_ORIGINS=*

# MongoDB Atlas connection string. Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/studyforielts?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=studyforielts

# Required for POST /admin/add-video when NODE_ENV=production.
ADMIN_TOKEN=replace-with-a-long-random-secret

DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=25
FEED_PAGE_SIZE=20
MAX_FEED_PAGE_SIZE=50
YOUTUBE_REQUEST_TIMEOUT_MS=15000
